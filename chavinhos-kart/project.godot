[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="walls"
3d_physics/layer_3="karts"
3d_physics/layer_4="items"
3d_physics/layer_5="triggers"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=30.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.1, 0.12, 0.2, 1)
