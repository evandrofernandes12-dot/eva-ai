; Engine configuration file.
; Gerado para o MVP "Chavinho's Kart" (Godot 4.3+)
config_version=5

[application]

config/name="Chavinho's Kart"
config/description="Kart arcade 3D inspirado no universo de El Chavo del Ocho."
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

Global="*res://scripts/autoload/Global.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

